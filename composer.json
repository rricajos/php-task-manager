{
    "name": "rricajos/php-task-manager",
    "description": "CLI + REST API task manager built with PHP 8.x, SQLite, JWT auth, and design patterns",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Ricard Penin Honrubia",
            "homepage": "https://github.com/rricajos"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "MiniProject\\": "src/"
        },
        "classmap": [
            "src/Task.php",
            "src/AppException.php",
            "src/ExportService.php",
            "src/Router.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "start:cli": "php app.php",
        "start:api": "php -S localhost:8080 api.php"
    },
    "config": {
        "sort-packages": true
    }
}
