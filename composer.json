{
    "name": "rricajos/php-task-manager",
    "description": "CLI + REST API task manager built with PHP 8.x, SQLite, JWT auth, and design patterns",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Ricard Penin Honrubia",
            "homepage": "https://github.com/rricajos"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "MiniProject\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "start:cli": "php app.php",
        "start:api": "php -S localhost:8080 api.php"
    },
    "config": {
        "sort-packages": true
    }
}
